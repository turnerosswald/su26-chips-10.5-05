%h1 Bills

%h2 Saved Bills
- if @saved_bills.present?
  %table
    %tr
      %th #
      %th Title
      %th Congress
      %th Type
      %th Chamber
      %th
        %span.visually-hidden Actions
    - @saved_bills.each do |bill|
      %tr
        %td #{bill.type} #{bill.number}
        %td= bill.title
        %td= bill.congress
        %td= bill.type
        %td= bill.original_chamber
        %td= link_to 'View', bill_path(bill)
- else
  %p No bills saved yet.

%h2 Search Bills
= form_tag bills_path, method: :get do
  = number_field_tag :congress, params[:congress], placeholder: 'Congress', aria: { label: 'Congress' }
  - bill_type_options = options_for_select(@bill_types, params[:bill_type])
  = select_tag :bill_type, bill_type_options, include_blank: 'Any type', aria: { label: 'Bill Type' }
  = submit_tag 'Search'

- if @bills.present?
  %p Showing #{@bills.length} of #{@total} results

  %table
    %tr
      %th #
      %th Title
      %th Congress
      %th Type
      %th Chamber
      %th Last Action
      %th
        %span.visually-hidden Actions
    - @bills.each do |bill|
      %tr
        %td #{bill['type']} #{bill['number']}
        %td= bill['title']
        %td= bill['congress']
        %td= bill['type']
        %td= bill['originChamber']
        %td
          = bill.dig('latestAction', 'text')
          on
          = Date.parse(bill.dig('latestAction', 'actionDate')).strftime('%b %-d, %Y')
        %td
          = button_to 'Save', bills_path(save_bill_params(bill)), method: :post
- elsif params[:congress] || params[:bill_type]
  %p No results found.
